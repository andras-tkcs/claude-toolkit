{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andras-tkcs/claude-toolkit/plugins/devflow/schema/profile.schema.json",
  "title": "devflow project profile (.claude/toolkit.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["docs", "git", "verify", "stacks"],
  "$defs": {
    "command": {
      "description": "A shell command, or a mapping with options.",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "run": {"type": "string", "minLength": 1},
            "cwd": {"type": "string", "description": "Directory, relative to the repo root, to run in."},
            "narrow": {"type": "string", "description": "Replacement command when /dod got arguments; {args} is substituted."},
            "skip_when_narrowed": {"type": "boolean", "description": "Report n/a (partial run) when /dod got arguments."}
          }
        }
      ]
    },
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "properties": {
    "toolkit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1, "description": "Tag of the toolkit repo that install/session-start.sh installs. Required only when the SessionStart hook route is used."}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_read"],
      "properties": {
        "must_read": {"$ref": "#/$defs/stringList", "description": "Files the planner, workers and reviewer read first. May be empty."},
        "plan_dir": {"type": "string", "minLength": 1, "default": "docs/"},
        "adr_dir": {"type": "string", "minLength": 1, "description": "Present means ADRs are used."},
        "adr_index": {"type": "string", "minLength": 1},
        "adr_bar": {"type": "string", "minLength": 1, "description": "Where the criteria for needing an ADR are written (path or path#anchor)."},
        "changelog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "section"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "section": {"type": "string", "minLength": 1, "description": "Heading user-visible changes go under, for example '## [Unreleased]'."}
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_branch", "branch_pattern"],
      "properties": {
        "main_branch": {"type": "string", "minLength": 1},
        "branch_pattern": {"type": "string", "minLength": 1},
        "branch_types": {"$ref": "#/$defs/stringList"},
        "merge_style": {"enum": ["merge-commit", "squash"]}
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "dod"],
      "properties": {
        "fast": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "dod": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
        "dod_conditional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "do"],
            "properties": {
              "when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "Globs matched against the changed files."},
              "do": {"type": "string", "minLength": 1}
            }
          }
        },
        "dod_manual": {"$ref": "#/$defs/stringList"},
        "dod_doc": {"type": "string", "minLength": 1}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dispatchable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow", "use_when"],
            "properties": {
              "workflow": {"type": "string", "minLength": 1},
              "use_when": {"type": "string", "minLength": 1},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "stacks": {"$ref": "#/$defs/stringList", "description": "Stack skills to load (stack-<name>). May be empty."},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planner": {"enum": ["opus", "sonnet"], "default": "opus"},
        "orchestrator": {"enum": ["opus", "sonnet"], "default": "sonnet"},
        "worker": {"enum": ["opus", "sonnet"], "default": "sonnet"},
        "reviewer": {"enum": ["opus", "sonnet"], "default": "opus"}
      }
    },
    "project_steward": {"type": "string", "minLength": 1, "description": "Path to a project skill with policy that fits no other key."}
  }
}
